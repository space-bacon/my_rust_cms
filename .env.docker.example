# =============================================================================
# DOCKER DATABASE CONFIGURATION - PRODUCTION SETUP
# =============================================================================
# This is the ONLY database configuration that should be used.
# The Docker PostgreSQL container contains all your data and settings.
# 
# IMPORTANT: Always use this configuration to prevent data loss!
# =============================================================================

# Database Configuration (Docker PostgreSQL)
POSTGRES_USER=rustcms
POSTGRES_PASSWORD=your_secure_password_here
POSTGRES_DB=my_rust_cms

# Database URL - ALWAYS points to Docker database
DATABASE_URL=postgres://rustcms:your_secure_password_here@localhost:5432/my_rust_cms

# Application Configuration
RUST_LOG=info
BACKEND_HOST=127.0.0.1
BACKEND_PORT=8081

# Security - GENERATE NEW SECRETS FOR PRODUCTION
SESSION_SECRET=generate_a_secure_64_character_hex_string_here
JWT_SECRET=generate_a_secure_jwt_secret_key_here

# Email Configuration
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=your_email@example.com
SMTP_PASSWORD=your_app_password_here
FROM_EMAIL=your_email@example.com

# Application URLs
FRONTEND_URL=http://localhost:8080
BACKEND_URL=http://localhost:8081

# Development flags
DEVELOPMENT_MODE=true
HOT_RELOAD=true
